{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-plugins",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "setup": "bash ./install.sh",
    "setup:uninstall": "bash ./install.sh --uninstall",
    "release": "bash ./release.sh",
    "format:check": "bun run --filter @mtayfur/opencode-chat-tree fmt:check",
    "typecheck": "bun run --workspaces --sequential typecheck",
    "build": "bun run --workspaces --sequential build",
    "check": "bun run format:check && bun run typecheck && bun run build"
  },
  "packageManager": "bun@1.3.14"
}

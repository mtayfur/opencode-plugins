{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@mtayfur/opencode-cache-view",
  "version": "1.0.1",
  "description": "Minimal OpenCode TUI sidebar for cache hit, estimated tokens, and generation speed.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mtayfur/opencode-plugins.git",
    "directory": "packages/cache-view"
  },
  "bugs": {
    "url": "https://github.com/mtayfur/opencode-plugins/issues"
  },
  "homepage": "https://github.com/mtayfur/opencode-plugins/tree/main/packages/cache-view#readme",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./tui": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run scripts/build.ts",
    "setup": "bash ./install.sh",
    "setup:uninstall": "bash ./install.sh --uninstall",
    "typecheck": "tsc --noEmit",
    "prepack": "bun run build"
  },
  "dependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.14.0",
    "@opencode-ai/sdk": ">=1.14.0",
    "@opentui/core": ">=0.2.0",
    "@opentui/solid": ">=0.2.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.16",
    "@opencode-ai/sdk": "1.18.16",
    "@opentui/core": "^0.5.1",
    "@opentui/solid": "^0.5.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.8.0"
  },
  "engines": {
    "bun": ">=1.3.14",
    "opencode": ">=1.18.16 <2"
  },
  "keywords": [
    "opencode",
    "plugin",
    "cache",
    "tokens",
    "tui"
  ],
  "packageManager": "bun@1.3.14"
}
